        <groups>
<!-- there can be only one <run> in a xml file-->
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="runners.MainRunner" ></class>
        </classes>
    </test>

</suite>